# MIR dump exposes representation value identities
mode: raw

+ "mir instr fn=return_ptr_param"
+ "mir type_identity fn=return_ptr_param id="
+ "mir value_identity fn=return_ptr_param id=0 spelling=p"
+ "representation_facts=2"
+ "kind=typed_load detail=p type=*mut value_id=p"
+ "kind=representation_check detail=nonnull_pointer type=*mut value_id=p"
+ "mir instr fn=read_ptr_param"
+ "mir type_identity fn=read_ptr_param id="
+ "mir span_identity fn=read_ptr_param id="
+ "spelling=*mut"
+ "mir value_identity fn=read_ptr_param id=0 spelling=p"
+ "kind=representation_use detail=deref_base type=*mut value_id=p"
+ "mir representation_fact fn=return_ptr_param kind=typed_load detail=p type=*mut value_id=p recorded=true"
+ "mir representation_fact fn=return_ptr_param kind=representation_check detail=nonnull_pointer type=*mut value_id=p recorded=true"
+ "mir representation_fact fn=read_ptr_param kind=representation_use detail=deref_base type=*mut value_id=p recorded=true"
