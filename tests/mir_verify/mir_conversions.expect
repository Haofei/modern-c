# MIR verifier reports general return local and assignment conversions
mode: raw

- "mir verify fn=accept_matching_return pass=conversion"
- "mir verify fn=accept_nonnull_to_nullable pass=conversion"
+ "mir verify fn=reject_return_type pass=conversion finding=return_type_mismatch source_type=u32"
+ "mir verify fn=reject_local_initializer pass=conversion finding=initializer_type_mismatch source_type=u32"
+ "mir verify fn=reject_assignment pass=conversion finding=assignment_type_mismatch source_type=u32"
- "mir verify fn=accept_return_pointer_const_narrow pass=conversion"
+ "mir verify fn=reject_return_pointer_element_conversion pass=conversion finding=return_pointer_conversion source_type=*mut"
+ "mir verify fn=reject_return_c_void_conversion pass=conversion finding=return_c_void_conversion source_type=*mut c_void"
- "mir verify fn=accept_initializer_pointer_const_narrow pass=conversion"
+ "mir verify fn=reject_initializer_pointer_element_conversion pass=conversion finding=initializer_pointer_conversion source_type=*mut"
+ "mir verify fn=reject_initializer_c_void_conversion pass=conversion finding=initializer_c_void_conversion source_type=*mut"
+ "mir verify fn=reject_nullable_initializer_pointer_conversion pass=conversion finding=initializer_pointer_conversion source_type=*mut"
+ "mir verify fn=reject_call_argument_type pass=conversion finding=call_arg_type_mismatch source_type=bool"
+ "mir verify fn=reject_call_argument_pointer pass=conversion finding=call_arg_pointer_conversion source_type=*const"
+ "mir verify fn=reject_call_argument_c_void pass=conversion finding=call_arg_c_void_conversion source_type=*mut"
+ "mir verify fn=reject_assert_condition_type pass=conversion finding=condition_type_mismatch source_type=u32"
+ "mir verify fn=reject_while_condition_type pass=conversion finding=condition_type_mismatch source_type=u32"
+ "mir verify fn=reject_for_base_type pass=conversion finding=for_base_not_iterable source_type=u32"
+ "mir verify fn=reject_index_base_type pass=conversion finding=index_base_not_array_or_slice source_type=u32"
+ "mir verify fn=reject_index_operand_type pass=conversion finding=index_not_usize source_type=bool"
+ "mir verify fn=reject_direct_call_return_pointer_element pass=conversion finding=return_pointer_conversion source_type=*mut"
+ "mir verify fn=reject_direct_call_return_c_void pass=conversion finding=return_c_void_conversion source_type=*mut c_void"
+ "mir verify fn=reject_member_assignment_pointer_conversion pass=conversion finding=assignment_pointer_conversion source_type=*const"
+ "mir verify fn=reject_deref_assignment_type pass=conversion finding=assignment_type_mismatch source_type=bool"
+ "mir verify fn=reject_index_assignment_pointer pass=conversion finding=assignment_pointer_conversion source_type=*const"
+ "mir verify fn=reject_cast_return_type pass=conversion finding=return_type_mismatch source_type=i32"
+ "mir verify fn=reject_cast_local_initializer pass=conversion finding=initializer_type_mismatch source_type=i32"
+ "mir verify fn=reject_cast_assignment pass=conversion finding=assignment_type_mismatch source_type=i32"
+ "mir verify fn=reject_cast_call_argument pass=conversion finding=call_arg_type_mismatch source_type=i32"
+ "mir verify fn=reject_cast_nullable_to_nonnull pass=nullability finding=nullable_to_nonnull"

# reported diagnostics
+ "E_RETURN_TYPE_MISMATCH"
+ "E_NO_IMPLICIT_CONVERSION"
+ "E_NO_IMPLICIT_POINTER_CONVERSION"
+ "E_C_VOID_CONVERSION"
+ "E_CONDITION_NOT_BOOL"
+ "E_FOR_BASE_NOT_ARRAY_OR_SLICE"
+ "E_INDEX_BASE_NOT_ARRAY_OR_SLICE"
+ "E_INDEX_NOT_USIZE"
