# MIR verifier recurses into target typed aggregate literal conversions
mode: raw

- "mir verify fn=accept_aggregate_literals pass=conversion"
- "mir verify fn=accept_aggregate_literals pass=nullability"
+ "mir verify fn=accept_pointer_aggregate_field pass=representation finding=representation_use detail=aggregate_field type=*mut"
+ "mir verify fn=accept_pointer_aggregate_element pass=representation finding=representation_use detail=aggregate_element type=*mut"
+ "mir verify fn=accept_member_aggregate_field pass=representation finding=representation_use detail=aggregate_field type=*mut"
+ "mir verify fn=accept_index_aggregate_field pass=representation finding=representation_use detail=aggregate_field type=*mut"
+ "mir verify fn=reject_struct_fields pass=conversion finding=integer_literal_out_of_range source_type=comptime_int"
+ "mir verify fn=reject_struct_fields pass=nullability finding=null_to_nonnull"
+ "mir verify fn=reject_local_array_element pass=conversion finding=integer_literal_out_of_range source_type=comptime_int"
+ "mir verify fn=reject_assignment_array_element pass=conversion finding=integer_literal_out_of_range source_type=comptime_int"
+ "mir verify fn=reject_call_array_element pass=conversion finding=integer_literal_out_of_range source_type=comptime_int"
+ "mir verify fn=reject_short_array pass=aggregate finding=array_literal_length type=array"
+ "mir verify fn=reject_long_array pass=aggregate finding=array_literal_length type=array"
+ "mir verify fn=reject_missing_struct_field pass=aggregate finding=struct_literal_missing_field type=Packet"
+ "mir verify fn=reject_duplicate_struct_field pass=aggregate finding=struct_literal_duplicate_field type=Packet"
+ "mir verify fn=reject_unknown_struct_field pass=aggregate finding=struct_literal_unknown_field type=Packet"
- "mir verify fn=accept_alias_aggregate_literals pass=conversion"
- "mir verify fn=accept_alias_aggregate_literals pass=nullability"
+ "mir verify fn=reject_alias_array_element pass=conversion finding=integer_literal_out_of_range source_type=comptime_int"
+ "mir verify fn=reject_alias_struct_fields pass=conversion finding=integer_literal_out_of_range source_type=comptime_int"
+ "mir verify fn=reject_alias_struct_fields pass=nullability finding=null_to_nonnull"
+ "mir verify fn=reject_alias_call_array_element pass=conversion finding=integer_literal_out_of_range source_type=comptime_int"
+ "mir verify fn=reject_cast_array_element pass=conversion finding=integer_literal_out_of_range source_type=comptime_int"
+ "mir verify fn=reject_cast_short_array pass=aggregate finding=array_literal_length type=array"
+ "mir verify fn=reject_cast_struct_fields pass=conversion finding=integer_literal_out_of_range source_type=comptime_int"
+ "mir verify fn=reject_cast_struct_fields pass=nullability finding=null_to_nonnull"
+ "mir verify fn=reject_cast_missing_struct_field pass=aggregate finding=struct_literal_missing_field type=Packet"
- "mir verify fn=accept_packed_bits_literals pass=conversion"
- "mir verify fn=accept_packed_bits_literals pass=aggregate"
+ "mir verify fn=reject_packed_bits_field_type pass=conversion finding=return_type_mismatch source_type=comptime_int"
+ "mir verify fn=reject_packed_bits_missing_field pass=aggregate finding=struct_literal_missing_field type=Flags"
+ "mir verify fn=reject_packed_bits_duplicate_field pass=aggregate finding=struct_literal_duplicate_field type=Flags"
+ "mir verify fn=reject_packed_bits_unknown_field pass=aggregate finding=struct_literal_unknown_field type=Flags"

# reported diagnostics
+ "E_INTEGER_LITERAL_OUT_OF_RANGE"
+ "E_NULL_NON_NULL_POINTER"
+ "E_ARRAY_LITERAL_LENGTH"
+ "E_STRUCT_LITERAL_MISSING_FIELD"
+ "E_DUPLICATE_STRUCT_LITERAL_FIELD"
+ "E_UNKNOWN_STRUCT_FIELD"
+ "E_RETURN_TYPE_MISMATCH"
