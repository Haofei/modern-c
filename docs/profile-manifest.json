  "profiles": [
    {
      "id": "compiler-subset",
      "status": "qualified-subset",
      "production_claim": false,
      "summary": "The admitted language/compiler subset: loader, parser, sema, MIR verification, C reference backend, diagnostics, source maps, CLI, and backend parity for covered fixtures.",
      "scope": {
        "blocking": [
          "src/",
          "std/",
          "tests/spec/",
          "tests/c_emit/",
          "tools/toolchain/"
        ],
        "experimental_or_excluded": [
          "selfhost/",
          "kernel production claims",
          "advanced incremental LSP",
          "QuickJS/WAMR runtime profiles"
        ]
      },
      "blocking_risks": [
        "ARCH-TYPED-MIR",
        "ARCH-BACKEND-FACTS",
        "ARCH-SOURCE-MAP-DIGEST",
        "GATE-MANIFEST"
      ],
      "blocking_gates": [
        "test",
        "test-lint",
        "bad-diagnostics-test",
        "diagnostics-reference-test",
        "diagnostic-code-inventory-test",
        "compilation-session-inventory-test",
        "mir-identity-inventory-test",
        "semantic-facts-inventory-test",
        "c-test",
        "sweep",
        "diff-backend",
        "mcc-cli-test",
        "mcc-build-test",
        "gate-manifest-test",
        "path-remap-test",
        "mcmap-test"
      ],
      "components": [
        "zig-compiler",
        "clang-for-c-artifact-checks",
        "llvm-for-differential-checks"
      ]
    },
    {
      "id": "llvm-experimental",
      "status": "experimental",
      "production_claim": false,
      "summary": "LLVM backend coverage is used for verifier/object/parity evidence, but it is not a separate production semantic authority until typed MIR/fact boundaries are complete.",
      "scope": {
        "blocking": [
          "src/lower_llvm*.zig",
          "tests/llvm/",
          "LLVM differential fixtures"
        ],
        "experimental_or_excluded": [
          "full backend parity claim",
          "third-party backend API claim",
          "independent production compiler claim"
        ]
      },
      "blocking_risks": [
        "BACKEND-LLVM-PROFILE",
        "ARCH-TYPED-MIR",
        "ARCH-BACKEND-FACTS"
      ],
      "blocking_gates": [
        "llvm-test",
        "llvm-obj-test",
        "llvm-sweep",
